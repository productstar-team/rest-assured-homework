<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.example</groupId>
    <artifactId>rest-assured-homework</artifactId>
    <version>1.0</version>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>5.10.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>5.5.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.17.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <!-- JUnit 5 requires Surefire version 2.22.0 or higher -->
                <version>2.22.0</version>
                <executions>
                    <!-- Отключаем дефолтный запуск, чтобы управлять порядком вручную -->
                    <execution>
                        <id>default-test</id>
                        <phase>none</phase>
                    </execution>
                    <!-- 1. Предварительная настройка данных -->
                    <execution>
                        <id>step1-setup</id>
                        <phase>test</phase>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <includes>
                                <include>**/setup/PetClinicSetupTest.java</include>
                            </includes>
                        </configuration>
                    </execution>
                    <!-- 2. Позитивный сценарий -->
                    <execution>
                        <id>step2-positive</id>
                        <phase>test</phase>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <includes>
                                <include>**/positive/PositiveVisitTest.java</include>
                            </includes>
                        </configuration>
                    </execution>
                    <!-- 3. Негативный сценарий -->
                    <execution>
                        <id>step3-negative</id>
                        <phase>test</phase>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <includes>
                                <include>**/negative/NegativeVisitTest.java</include>
                            </includes>
                        </configuration>
                    </execution>
                    <!-- 4. Базовые тесты из репозитория -->
                    <execution>
                        <id>step4-simple</id>
                        <phase>test</phase>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <includes>
                                <include>**/SimpleTest.java</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
